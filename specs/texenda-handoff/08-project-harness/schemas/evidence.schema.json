{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texenda:harness:evidence:1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "enum": [
        "submission",
        "review",
        "integration",
        "checkpoint",
        "recovery",
        "roster",
        "budget",
        "gate",
        "trigger"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "candidate_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "command_or_procedure": {
            "type": "string"
          },
          "evidence_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrated_revision": {
      "type": "string"
    },
    "runtime_stopped": {
      "type": "boolean"
    },
    "conflict_resolution_changed_semantics": {
      "type": "boolean"
    },
    "previous_fence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_revision": {
      "type": "string"
    },
    "qualifications": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "gate_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "expires_at": {
      "type": "string"
    },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    }
  }
}
