def snapshot():
    rows={}
    for scope in scopes:
        for folder, dirs, files in os.walk(scope):
            dirs[:]=sorted(x for x in dirs if x not in ('.git','.texenda','private-inputs'))
            for name in sorted(files):
                path=Path(folder)/name
                if name=='.git':continue
