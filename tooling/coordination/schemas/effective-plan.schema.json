{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texenda:effective-plan:1",
  "description": "Closed shape of ADR-0008's single machine block. This schema supplies no independent plan rows.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "decision",
    "owner_decision_date",
    "sealed_catalog_sha256",
    "sealed_profiles_sha256",
    "sealed_acceptance_sha256",
    "authority",
    "work_package_updates",
    "acceptance_extensions",
    "additional_profiles",
    "profile_updates",
    "synthetic_forbidden_dependencies",
    "evidence_rule",
    "coordinator_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "texenda.initial-product.v1"
    },
    "id": {
      "const": "PLAN-IP-0001"
    },
    "decision": {
      "const": "docs/decisions/ADR-0008-integrated-initial-product-and-effective-plan.md"
    },
    "owner_decision_date": {
      "type": "string",
      "pattern": "[0-9]{4}-[0-9]{2}-[0-9]{2}"
    },
    "sealed_catalog_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "sealed_profiles_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "sealed_acceptance_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "work_package_updates": {
      "type": "array",
      "minItems": 29,
      "maxItems": 29,
      "items": {
        "$ref": "#/$defs/work_package_update"
      }
    },
    "acceptance_extensions": {
      "type": "array",
      "minItems": 18,
      "maxItems": 18,
      "items": {
        "$ref": "#/$defs/extension"
      }
    },
    "additional_profiles": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "$ref": "#/$defs/profile"
      }
    },
    "profile_updates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "items": {
        "$ref": "#/$defs/profile_update"
      }
    },
    "synthetic_forbidden_dependencies": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_rule": {
      "type": "string",
      "minLength": 1
    },
    "coordinator_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "base_state_version",
        "active_state_version",
        "activation",
        "preserve_sealed_catalog_digest",
        "preserve_routing_policy_and_roster",
        "preserve_prior_events_tasks_and_evidence",
        "implicit_activation",
        "old_lifecycle_reader",
        "old_context",
        "future_tasks",
        "fallback"
      ],
      "properties": {
        "base_state_version": {
          "const": "2.0"
        },
        "active_state_version": {
          "const": "2.1"
        },
        "activation": {
          "const": "explicit_reviewed_forward_receipt_only"
        },
        "preserve_sealed_catalog_digest": {
          "const": true
        },
        "preserve_routing_policy_and_roster": {
          "const": true
        },
        "preserve_prior_events_tasks_and_evidence": {
          "const": true
        },
        "implicit_activation": {
          "const": false
        },
        "old_lifecycle_reader": {
          "const": "fails_closed"
        },
        "old_context": {
          "const": "unbound_sealed_context_is_not_valid_dispatch"
        },
        "future_tasks": {
          "const": "bind_effective_plan_digest"
        },
        "fallback": {
          "const": "preserve_checkpoint_and_repair_forward_no_history_rewrite"
        }
      }
    }
  },
  "$defs": {
    "work_package_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "reason",
        "replace",
        "append"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "WP-[0-9]{2}"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "replace": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "dependencies": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope": {
              "type": "string",
              "minLength": 1
            },
            "activation": {
              "enum": [
                "AUTHORITATIVE DECISION",
                "DEFER UNTIL TRIGGERED",
                "REQUIRES EXTERNAL VALIDATION"
              ]
            },
            "triggers": {
              "type": "string",
              "minLength": 1
            },
            "external_gates_for_activation": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expected_outputs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "acceptance_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            },
            "acceptance_criteria": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "append": {
          "type": "object",
          "additionalProperties": false,
          "required": [],
          "properties": {
            "scope": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "allowed_paths": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "expected_outputs": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "acceptance_criteria": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "acceptance_ids": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "extension": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "work_packages",
        "sealed_criteria",
        "scenario",
        "pass_condition",
        "evidence_status"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "AC-IP[0-9]{2}"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "work_packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "sealed_criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "scenario": {
          "type": "string",
          "minLength": 1
        },
        "pass_condition": {
          "type": "string",
          "minLength": 1
        },
        "evidence_status": {
          "const": "NOT_RUN"
        }
      }
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parents",
        "requires_work_packages",
        "required_criteria",
        "requires_gates",
        "scope",
        "evidence_mode"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "parents": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_work_packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "required_criteria": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "requires_gates": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "evidence_mode": {
          "enum": [
            "synthetic",
            "real-qualified"
          ]
        }
      }
    },
    "profile_update": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "replace",
        "append"
      ],
      "properties": {
        "id": {
          "const": "email-pilot"
        },
        "replace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "parents",
            "scope"
          ],
          "properties": {
            "parents": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "scope": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "append": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requires_work_packages"],
          "properties": {
            "requires_work_packages": {
              "type": "array",
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}
