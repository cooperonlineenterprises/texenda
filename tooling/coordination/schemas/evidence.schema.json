{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:texenda:local-harness:evidence:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "summary",
    "checks"
  ],
  "properties": {
    "schema_version": {
      "enum": ["2.0", "2.1"]
    },
    "effective_plan_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$",
      "description": "Required on version-2.1 lifecycle evidence. Never replaces the historical sealed catalog digest or qualification policy binding."
    },
    "kind": {
      "enum": [
        "submission",
        "review",
        "integration",
        "checkpoint",
        "recovery",
        "roster",
        "budget",
        "gate",
        "trigger",
        "routing"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "candidate_revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "required",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "NOT_APPLICABLE"
            ]
          },
          "command_or_procedure": {
            "type": "string"
          },
          "evidence_path": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "changed_paths": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrated_revision": {
      "type": "string"
    },
    "runtime_stopped": {
      "type": "boolean"
    },
    "conflict_resolution_changed_semantics": {
      "type": "boolean"
    },
    "previous_fence": {
      "type": "integer",
      "minimum": 0
    },
    "observed_revision": {
      "type": "string"
    },
    "qualifications": {
      "type": "array",
      "items": {
        "$ref": "profile-qualification.schema.json"
      }
    },
    "gate_id": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    },
    "work_packages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": "string"
    },
    "routing_policy_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "work_package_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "profile_id": {
      "type": "string",
      "minLength": 1
    },
    "role": {
      "enum": [
        "author",
        "reviewer"
      ]
    },
    "capability_tier": {
      "type": "integer",
      "enum": [
        1,
        2,
        3,
        4
      ]
    },
    "fence": {
      "type": "integer",
      "minimum": 1
    },
    "rationale": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_demand": {
      "enum": [
        "bounded",
        "mechanical"
      ]
    },
    "bounded": {
      "type": "boolean"
    },
    "reversible": {
      "type": "boolean"
    },
    "fully_specified": {
      "type": "boolean"
    },
    "deterministic_verification": {
      "type": "boolean"
    },
    "owner": {
      "type": "string",
      "pattern": "^human:.+"
    },
    "approved_budget_usd": {
      "type": "number",
      "minimum": 0,
      "maximum": 100000
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "author",
          "reviewer"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "2.1"}}},
      "then": {"required": ["effective_plan_digest"]}
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "roster"
          }
        }
      },
      "then": {
        "required": [
          "routing_policy_digest",
          "qualifications"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "review"
          }
        }
      },
      "then": {
        "required": [
          "routing_policy_digest",
          "profile_id",
          "task_id",
          "candidate_revision"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "routing"
          }
        }
      },
      "then": {
        "required": [
          "routing_policy_digest",
          "work_package_digest",
          "profile_id",
          "role",
          "task_id",
          "capability_tier",
          "fence",
          "expires_at",
          "rationale",
          "reasoning_demand",
          "bounded",
          "reversible",
          "fully_specified",
          "deterministic_verification"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "role": {
                  "const": "reviewer"
                }
              }
            },
            "then": {
              "required": [
                "candidate_revision"
              ]
            }
          }
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "budget"
          }
        }
      },
      "then": {
        "required": [
          "schema_version",
          "kind",
          "summary",
          "checks",
          "owner",
          "approved_budget_usd",
          "scope",
          "work_packages",
          "roles",
          "issued_at",
          "expires_at",
          "routing_policy_digest",
          "work_package_digest"
        ],
        "propertyNames": {
          "enum": [
            "schema_version",
            "kind",
            "summary",
            "checks",
            "owner",
            "approved_budget_usd",
            "scope",
            "work_packages",
            "roles",
            "issued_at",
            "expires_at",
            "routing_policy_digest",
            "work_package_digest",
            "notes"
          ]
        },
        "properties": {
          "scope": {
            "type": "string",
            "pattern": "\\S"
          },
          "work_packages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^WP-[0-9]{2}$"
            }
          }
        },
        "description": "Runtime also enforces exact CLI amount/owner, current task and role coverage, matching policy/catalog, explicit timezone, issued_at <= now < expires_at, and a maximum 30-day window."
      }
    }
  ]
}
